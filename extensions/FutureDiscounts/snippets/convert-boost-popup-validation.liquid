// Function to validate popup based on hesitation score
async function validatePopupWithBackend(popupConfig) {
  const validationLogger = {
    error: (msg, data) => console.error(`[Validation] ${msg}`, data || '')
  };

  try {
    // Get current hesitation score from tracker
    if (typeof window.convertBoostHesitationTracker === 'undefined') {
      console.warn('[Validation] ⚠️ Hesitation tracker not loaded yet');
      return { shouldShow: false, error: 'Tracker not loaded' };
    }

    var tracker = window.convertBoostHesitationTracker;
    var scoreData = tracker.getScore();
    
    if (!scoreData) {
      console.warn('[Validation] ⚠️ Could not get hesitation score');
      return { shouldShow: false, error: 'Could not get score' };
    }

    var currentScore = scoreData.score || 0;
    var threshold = popupConfig.hesitationThreshold || 50;

    // Frontend optimization: Check locally first
    var shouldShow = currentScore >= threshold;

    if (shouldShow) {
      console.log(`[Validation] ✅ Hesitation check passed: Score ${currentScore.toFixed(2)} >= Threshold ${threshold}`);
      return { 
        shouldShow: true, 
        hesitationScore: currentScore,
        threshold: threshold,
        optimized: true
      };
    } else {
      console.log(`[Validation] ❌ Hesitation check failed: Score ${currentScore.toFixed(2)} < Threshold ${threshold}`);
      return { 
        shouldShow: false, 
        hesitationScore: currentScore,
        threshold: threshold,
        reason: `Hesitation score (${currentScore.toFixed(2)}) below threshold (${threshold})`
      };
    }

  } catch (error) {
    validationLogger.error('💥 Error validating popup with hesitation score', { 
      error: error.message,
      stack: error.stack 
    });
    
    // On error, default to not showing popup for safety
    return { 
      shouldShow: false, 
      error: error.message,
      fallback: 'Error - defaulting to hide popup for safety'
    };
  }
}

// Helper function to check hesitation score (can be used anywhere in the extension)
function checkHesitationScore(threshold) {
  try {
    if (typeof window.convertBoostHesitationTracker === 'undefined') {
      return {
        success: false,
        error: 'Tracker not loaded',
        score: 0,
        threshold: threshold,
        passed: false
      };
    }

    var tracker = window.convertBoostHesitationTracker;
    var scoreData = tracker.getScore();
    
    if (!scoreData) {
      return {
        success: false,
        error: 'Could not get score',
        score: 0,
        threshold: threshold,
        passed: false
      };
    }

    var currentScore = scoreData.score || 0;
    var passed = currentScore >= threshold;

    return {
      success: true,
      score: currentScore,
      threshold: threshold,
      passed: passed,
      rawH: scoreData.rawH,
      categoryScores: scoreData.categoryScores
    };

  } catch (error) {
    console.error('[HesitationCheck] ❌ Error checking hesitation score', error);
    return {
      success: false,
      error: error.message,
      score: 0,
      threshold: threshold,
      passed: false
    };
  }
}
